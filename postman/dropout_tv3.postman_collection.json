{
 "info": {
  "name": "Dropout API - TV3",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "variable": [
  {
   "key": "scoring_uri",
   "value": "https://<endpoint>.<region>.inference.ml.azure.com/score"
  },
  {
   "key": "scoring_key",
   "value": ""
  },
  {
   "key": "web_url",
   "value": "https://<ten-web>.azurewebsites.net"
  },
  {
   "key": "big_body",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1 - Hop le (3 sinh vien)",
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
       "const b = pm.response.json();",
       "pm.test('tra ve 3 ket qua', () => pm.expect(b).to.be.an('array').with.lengthOf(3));",
       "pm.test('risk_level hop le', () => b.forEach(x => pm.expect(['Thấp','Trung bình','Cao']).to.include(x.risk_level)));",
       "pm.test('co top_factors', () => b.forEach(x => pm.expect(x.top_factors).to.be.an('array')));"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "Authorization",
      "value": "Bearer {{scoring_key}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
