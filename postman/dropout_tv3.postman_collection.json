  {
   "name": "5 - File lon 500 sinh vien",
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const rec = {\"STUDENT_IDENTIFIER\": 9000002, \"STDNT_AGE\": 18, \"STDNT_GENDER\": \"M\", \"STDNT_BACKGROUND\": \"BGD 1\", \"IN_STATE_FLAG\": \"Y\", \"INTERNATIONAL_STS\": \"N\", \"STDNT_MAJOR\": \"Undeclared\", \"STDNT_MINOR\": \"N\", \"HIGH_SCHL_GPA\": 2.4, \"STDNT_TEST_ENTRANCE_COMB\": 1180, \"FATHER_HI_EDU_CD\": 3, \"MOTHER_HI_EDU_CD\": 3, \"HOUSING_STS\": \"Off Campus\", \"DISTANCE_FROM_HOME\": 180, \"FIRST_TERM\": 200908, \"FIRST_TERM_ATTEMPT_HRS\": 15, \"FIRST_TERM_EARNED_HRS\": 6, \"SECOND_TERM\": 201002, \"SECOND_TERM_ATTEMPT_HRS\": null, \"SECOND_TERM_EARNED_HRS\": null, \"GROSS_FIN_NEED\": 8000, \"COST_OF_ATTEND\": 18000, \"EST_FAM_CONTRIBUTION\": 9000, \"UNMET_NEED\": 9000, \"CORE_COURSE_GRADE_1_F\": \"D\", \"CORE_COURSE_GRADE_2_F\": \"F\", \"CORE_COURSE_GRADE_3_F\": \"C\", \"CORE_COURSE_GRADE_4_F\": \"F\"};",
       "const data = [];",
       "for (let i = 0; i < 500; i++) { data.push(Object.assign({}, rec, {STUDENT_IDENTIFIER: 9200000 + i})); }",
       "pm.collectionVariables.set('big_body', JSON.stringify({data: data}));"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
       "pm.test('du 500 ket qua', () => pm.expect(pm.response.json()).to.have.lengthOf(500));",
       "pm.test('duoi 60 giay', () => pm.expect(pm.response.responseTime).to.be.below(60000));"
      ]
     }
    }
   ],
   "request": {
    "method": "POST",
    "header": [
