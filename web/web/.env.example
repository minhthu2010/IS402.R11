# Chép thành .env (đã được .gitignore) rồi điền giá trị thật. KHÔNG commit file .env.
MOCK_API=true
SCORING_URI=https://<endpoint>.<region>.inference.ml.azure.com/score
SCORING_KEY=
SQL_SERVER=sql-dropout-thi.database.windows.net
SQL_DB=dropoutdb
SQL_USER=app_writer
SQL_PASSWORD=
LAKE_CONN=DefaultEndpointsProtocol=https;AccountName=stdropoutthi1;AccountKey=...;EndpointSuffix=core.windows.net
# Tùy chọn: URL HTTP của Function (có ?code=...) để chạy ngay sau khi upload
AUTO_TRIGGER_URL=
